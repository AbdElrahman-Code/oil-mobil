# --- Database (PostgreSQL) ---
DATABASE_URI=postgres://postgres:PASSWORD@127.0.0.1:5432/oil_project

# --- Payload ---
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Media storage ---
# On Vercel: attach a Blob store to the project and this is injected for you.
BLOB_READ_WRITE_TOKEN=

# Or bring your own bucket (S3 / Cloudflare R2). Leave blank to use local disk in dev.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# --- Payments: Paymob ---
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# --- Notifications ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER_API_KEY=

# --- Analytics ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
